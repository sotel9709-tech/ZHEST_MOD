{
  "schemaVersion": 1,
  "id": "zhest-mod",
  "version": "${version}",
  "name": "ЖЕСТЬ MOD",
  "description": "Мемный мод: меч ЕБЛАН с уроном 1000.",
  "authors": [
    "kocko"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/zhest-mod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.kocko.zhestmod.ZHESTMOD"
    ],
    "client": [
